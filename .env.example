# Cubic v2.0.0-alpha.2
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3001
API_BIND_ADDRESS=127.0.0.1
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=1

# Authentication
SESSION_COOKIE_NAME=cubic_session
# Keep false for plain HTTP/LAN testing. Set true when Cubic is served behind HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
REGISTRATION_ENABLED=true

# Web
WEB_HOST=0.0.0.0
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:3001

# PostgreSQL
POSTGRES_DB=cubic
POSTGRES_USER=cubic
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://cubic:change-me-in-production@localhost:5432/cubic
