# Cubic production deployment template.
# Copy to .env, then replace every required blank value before starting Cubic.
# Never use credentials copied from repository files in a production deployment.
NODE_ENV=production

# API
API_HOST=0.0.0.0
API_PORT=3001
API_BIND_ADDRESS=127.0.0.1
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=1

# Authentication
SESSION_COOKIE_NAME=cubic_session
# Required in production. Use docker-compose.dev.env plus docker-compose.dev.yml
# for explicitly opted-in plain-HTTP local development.
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=30
REGISTRATION_ENABLED=true

# Web
WEB_HOST=0.0.0.0
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:3001

# PostgreSQL
POSTGRES_DB=cubic
POSTGRES_USER=cubic
POSTGRES_PASSWORD=
# For host-run development, set DATABASE_URL separately with the same password.
DATABASE_URL=
MEDIA_ROOT=/data/media
GROUP_AVATAR_MAX_BYTES=2097152

# LiveKit voice (alpha.5)
LIVEKIT_PUBLIC_URL=wss://voice.goma.ink
LIVEKIT_NODE_IP=192.168.15.172
LIVEKIT_SIGNAL_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit network hardening (alpha.5)
# Keep false for the validated LAN-only topology.
# For Internet testing behind NAT, enable after forwarding ports on the router.
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_ADVERTISE_INTERNAL_IP=true
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_UDP_PORT=3478

# Attachments (alpha.7)
ATTACHMENT_MAX_BYTES=26214400
