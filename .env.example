# Cubic v2.0.0-alpha.5
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3001
API_BIND_ADDRESS=127.0.0.1
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=1

# Authentication
SESSION_COOKIE_NAME=cubic_session
# Keep false for plain HTTP/LAN testing. Set true when Cubic is served behind HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
REGISTRATION_ENABLED=true

# Web
WEB_HOST=0.0.0.0
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:3001

# PostgreSQL
POSTGRES_DB=cubic
POSTGRES_USER=cubic
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://cubic:change-me-in-production@localhost:5432/cubic
MEDIA_ROOT=/data/media
GROUP_AVATAR_MAX_BYTES=2097152

# LiveKit voice (alpha.5)
LIVEKIT_PUBLIC_URL=wss://voice.goma.ink
LIVEKIT_NODE_IP=192.168.15.172
LIVEKIT_SIGNAL_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters

# LiveKit network hardening (alpha.5)
# Keep false for the validated LAN-only topology.
# For Internet testing behind NAT, enable after forwarding ports on the router.
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_ADVERTISE_INTERNAL_IP=true
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_UDP_PORT=3478

# Attachments (alpha.7)
ATTACHMENT_MAX_BYTES=26214400
