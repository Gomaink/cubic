# Cubic production deployment template.
# Copy to .env, then replace every required blank value before starting Cubic.
# Never use credentials copied from repository files in a production deployment.
NODE_ENV=production

# API
API_HOST=0.0.0.0
API_PORT=3001
API_BIND_ADDRESS=127.0.0.1
CORS_ORIGIN=https://cubic.goma.ink
# Required for Compose deployments. Set this to the exact dedicated Cubic
# Docker network CIDR (for example, as reported by `docker network inspect`).
# Do not use a generic RFC1918 allowlist or a numeric proxy-hop count.
TRUST_PROXY_CIDRS=

# Authentication
SESSION_COOKIE_NAME=cubic_session
# Required in production. Use docker-compose.dev.env plus docker-compose.dev.yml
# for explicitly opted-in plain-HTTP local development.
SESSION_COOKIE_SECURE=true
# Sessions require both this 30-day absolute limit and activity inside the
# 7-day idle window. Values are milliseconds; zero/unlimited is not accepted.
SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_MS=604800000
# Shared Socket.IO session checks run once per 5 minutes, per unique session.
SESSION_SOCKET_REVALIDATE_MS=300000
REGISTRATION_ENABLED=true

# Web
WEB_HOST=0.0.0.0
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:3001

# PostgreSQL
POSTGRES_DB=cubic
POSTGRES_USER=cubic
POSTGRES_PASSWORD=
# For host-run development, set DATABASE_URL separately with the same password.
DATABASE_URL=
MEDIA_ROOT=/data/media
GROUP_AVATAR_MAX_BYTES=2097152

# LiveKit voice (alpha.5)
LIVEKIT_PUBLIC_URL=wss://voice.goma.ink
# API-only RoomService endpoint. Compose uses the private LiveKit service network.
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_AUTHORIZATION_RECONCILE_MS=30000
LIVEKIT_NODE_IP=192.168.15.172
LIVEKIT_SIGNAL_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit network hardening (alpha.5)
# Keep false for the validated LAN-only topology.
# For Internet testing behind NAT, enable after forwarding ports on the router.
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_ADVERTISE_INTERNAL_IP=true
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_UDP_PORT=3478

# Attachments (alpha.8 storage-abuse protection)
# All byte values are raw bytes and all interval/age values are milliseconds.
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_PENDING_MAX_COUNT=20
ATTACHMENT_PENDING_MAX_BYTES=262144000
ATTACHMENT_MIN_FREE_BYTES=1073741824
ATTACHMENT_UPLOAD_RATE_LIMIT_MAX=20
ATTACHMENT_UPLOAD_RATE_LIMIT_WINDOW_MS=60000
ATTACHMENT_CLEANUP_INTERVAL_MS=900000
ATTACHMENT_STALE_AGE_MS=86400000
ATTACHMENT_CLEANUP_BATCH_SIZE=250
ATTACHMENT_DELETION_INTERVAL_MS=30000
ATTACHMENT_DELETION_BATCH_SIZE=100
ATTACHMENT_DELETION_LEASE_MS=300000
ATTACHMENT_DELETION_RETRY_BASE_MS=5000
ATTACHMENT_DELETION_RETRY_MAX_MS=3600000
ATTACHMENT_RECONCILIATION_INTERVAL_MS=900000
# Also controls stale crash-interrupted staging upload cleanup.
ATTACHMENT_ORPHAN_GRACE_MS=86400000
ATTACHMENT_RECONCILIATION_SCAN_BATCH_SIZE=500
ATTACHMENT_RECONCILIATION_MISSING_BATCH_SIZE=250
